---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Brave for Good equips families with stories and community experiences grounded in faith and timeless values.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const programLinks = [
  { href: '/programs',                          label: 'All Programs' },
  { href: '/seeyouatthelibrary',                label: 'See You at the Library' },
  { href: '/programs/iggy-and-mr-kirk',         label: 'Faith Forward Content Creation' },
  { href: '/programs/bible-revival',            label: 'Bible Revival' },
  { href: '/programs/book-donations',           label: 'Book Donations' },
];

const navLinks = [
  { href: '/mission',            label: 'Our Mission' },
  { href: '/programs',           label: 'Programs', children: programLinks },
  { href: '/statement-of-faith', label: 'Statement of Faith' },
  { href: '/about',              label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Brave for Good</title>

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | Brave for Good`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <!-- Google tag (gtag.js) — one library load serving two destinations:
         GA4 analytics and the Google Ads conversion tag carried over from the
         Wix site. Both IDs are documented in CLAUDE.md. Do not add a second
         gtag/js script tag for a new destination; add another config call. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KEFP78X254"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-KEFP78X254');
      gtag('config', 'AW-17961146034');
    </script>

    <!-- Meta Pixel — base code for the Meta ad campaigns. Loaded on every page
         so PageView and retargeting audiences cover the whole site; the Lead
         event is fired by the landing page itself off the Klaviyo submit, not
         here. The same pixel ID is in LandingLayout.astro: change both together. -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1077091228332772');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" alt=""
      src="https://www.facebook.com/tr?id=1077091228332772&amp;ev=PageView&amp;noscript=1" /></noscript>
  </head>

  <body class="flex flex-col min-h-screen">

    <!-- Navigation -->
    <header class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Logo -->
          <a href="/">
            <img src="/images/logo-stacked.webp" alt="Brave for Good" class="h-12 w-auto" />
          </a>

          <!-- Right side: nav + CTA -->
          <div class="flex items-center gap-6">
            <nav class="hidden lg:flex items-center gap-6">
              {navLinks.map(link => (
                link.children ? (
                  <div class="relative group">
                    <a
                      href={link.href}
                      class="flex items-center gap-1 text-sm font-medium text-gray-700 hover:text-brand-rust transition-colors py-5"
                    >
                      {link.label}
                      <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </a>
                    <div class="absolute left-0 top-full w-72 bg-white border border-gray-200 shadow-lg rounded-lg py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-opacity">
                      {link.children.map(child => (
                        <a
                          href={child.href}
                          class="block px-4 py-2 text-sm text-gray-700 hover:text-brand-rust hover:bg-brand-cream transition-colors"
                        >
                          {child.label}
                        </a>
                      ))}
                    </div>
                  </div>
                ) : (
                  <a
                    href={link.href}
                    class="text-sm font-medium text-gray-700 hover:text-brand-rust transition-colors"
                  >
                    {link.label}
                  </a>
                )
              ))}
            </nav>

            <a href="/support" class="btn-primary text-sm py-2 px-4 hidden md:inline-block">
              Donate
            </a>

            <!-- Drawer trigger -->
            <button
              id="drawer-open"
              type="button"
              class="lg:hidden -mr-2 p-2 rounded-md text-gray-600 hover:text-brand-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-rust"
              aria-label="Open menu"
              aria-controls="drawer-panel"
              aria-expanded="false"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

    </header>

    <!-- Mobile drawer. Fixed and overlaid, so opening it never displaces page
         content. Panel slides on transform only; nothing here animates layout. -->
    <div class="lg:hidden">
      <div
        id="drawer-backdrop"
        class="fixed inset-0 z-[55] bg-brand-navy/50 opacity-0 pointer-events-none transition-opacity duration-300 ease-out"
      ></div>

      <aside
        id="drawer-panel"
        role="dialog"
        aria-modal="true"
        aria-label="Site menu"
        class="fixed inset-y-0 right-0 z-[60] flex w-[86%] max-w-sm translate-x-full flex-col bg-white shadow-2xl transition-transform duration-[400ms] [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] motion-reduce:transition-none"
      >
        <div class="flex items-center justify-between border-b border-gray-200 px-5 h-16 shrink-0">
          <img src="/images/logo-stacked.webp" alt="Brave for Good" class="h-10 w-auto" />
          <button
            id="drawer-close"
            type="button"
            class="-mr-2 p-2 rounded-md text-gray-500 hover:text-brand-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-rust"
            aria-label="Close menu"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <nav class="flex-1 overflow-y-auto overscroll-contain px-5 py-6" aria-label="Site">
          <ul class="space-y-1">
            {navLinks.map(link => (
              <li>
                <a
                  href={link.href}
                  class="block py-2 font-serif text-lg font-bold text-brand-navy hover:text-brand-rust transition-colors"
                >
                  {link.label}
                </a>
                {link.children && (
                  <ul class="mb-2 ml-1 space-y-0.5">
                    {link.children.filter(child => child.href !== link.href).map(child => (
                      <li>
                        <a
                          href={child.href}
                          class="flex items-baseline gap-2.5 py-1.5 text-sm text-gray-600 hover:text-brand-rust transition-colors"
                        >
                          <span class="text-brand-gold" aria-hidden="true">·</span>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>

        <div class="border-t border-gray-200 px-5 py-5 shrink-0">
          <a href="/support" class="btn-primary block text-center">Donate</a>
          <a
            href="/contact"
            class="mt-3 block text-center text-sm text-gray-500 hover:text-brand-rust transition-colors"
          >
            Contact us
          </a>
        </div>
      </aside>
    </div>

    <!-- Main content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-brand-navy text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- Brand column -->
          <div class="md:col-span-1">
            <img src="/images/logo-stacked.webp" alt="Brave for Good" class="h-14 w-auto brightness-0 invert" />
            <p class="mt-3 text-sm text-gray-300 leading-relaxed">
              Inspiring children to walk in God's ways through stories and experiences that nurture imagination and strengthen timeless values.
            </p>
            <div class="mt-5 flex items-center gap-3">
              <a
                href="https://facebook.com/braveforgood"
                target="_blank"
                rel="noopener"
                aria-label="Brave for Good on Facebook"
                class="p-2 rounded-lg text-gray-300 hover:text-white hover:bg-white/10 transition-colors"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.43c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.23h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07z"/>
                </svg>
              </a>
              <a
                href="https://www.instagram.com/braveforgood.usa"
                target="_blank"
                rel="noopener"
                aria-label="Brave for Good on Instagram"
                class="p-2 rounded-lg text-gray-300 hover:text-white hover:bg-white/10 transition-colors"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23a3.7 3.7 0 01-.9 1.38 3.7 3.7 0 01-1.38.9c-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 01-1.38-.9 3.7 3.7 0 01-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 3.68a6.16 6.16 0 100 12.32 6.16 6.16 0 000-12.32zm0 10.16a4 4 0 110-8 4 4 0 010 8zm7.85-10.4a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Quick links -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400 mb-4">Organization</h3>
            <ul class="space-y-2 text-sm text-gray-300">
              <li><a href="/mission" class="hover:text-white">Our Mission</a></li>
              <li><a href="/about" class="hover:text-white">Leadership & Board</a></li>
              <li><a href="/statement-of-faith" class="hover:text-white">Statement of Faith</a></li>
              <li><a href="/impact" class="hover:text-white">Impact</a></li>
              <li><a href="/grants" class="hover:text-white">For Funders</a></li>
              <li>
                <a
                  href="/documents/brave-for-good-501c3-determination-letter.pdf"
                  target="_blank"
                  rel="noopener"
                  class="hover:text-white"
                >
                  501(c)(3) Determination Letter
                </a>
              </li>
            </ul>
          </div>

          <!-- Programs -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400 mb-4">Programs</h3>
            <ul class="space-y-2 text-sm text-gray-300">
              <li><a href="/seeyouatthelibrary" class="hover:text-white">See You at the Library</a></li>
              <li><a href="/programs/iggy-and-mr-kirk" class="hover:text-white">Faith Forward Content Creation</a></li>
              <li><a href="/programs/bible-revival" class="hover:text-white">Bible Revival</a></li>
              <li><a href="/programs/book-donations" class="hover:text-white">Book Donations</a></li>
              <li><a href="/host" class="hover:text-white">Host a Story Hour</a></li>
            </ul>
          </div>

          <!-- Get involved -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400 mb-4">Get Involved</h3>
            <ul class="space-y-2 text-sm text-gray-300">
              <li><a href="/support" class="hover:text-white">Donate</a></li>
              <li><a href="/host" class="hover:text-white">Host an Event</a></li>
              <li><a href="/contact" class="hover:text-white">Contact Us</a></li>
            </ul>
            <div class="mt-5">
              <a href="/support" class="btn-primary text-sm py-2 px-4 inline-block">Donate Now</a>
            </div>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="mt-10 pt-6 border-t border-gray-700 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 text-xs text-gray-400">
          <div>
            <span>© 2025 Brave for Good. All rights reserved.</span>
            <span class="mx-2">·</span>
            <span>501(c)(3) nonprofit · EIN: <span class="font-mono">39-2416029</span></span>
          </div>
          <div class="flex gap-4">
            <a href="/privacy" class="hover:text-white">Privacy Policy</a>
            <a href="/terms" class="hover:text-white">Terms of Service</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile drawer -->
    <script>
      const openBtn = document.getElementById('drawer-open');
      const closeBtn = document.getElementById('drawer-close');
      const panel = document.getElementById('drawer-panel');
      const backdrop = document.getElementById('drawer-backdrop');

      if (openBtn && closeBtn && panel && backdrop) {
        let isOpen = false;

        // Closed panel stays in the DOM for the slide-out transition, so it has
        // to be made unreachable to tab order and screen readers explicitly.
        const setInert = (inert: boolean) => {
          panel.inert = inert;
          panel.setAttribute('aria-hidden', String(inert));
        };
        setInert(true);

        const focusables = () =>
          Array.from(
            panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
          ).filter(el => el.offsetParent !== null);

        const open = () => {
          if (isOpen) return;
          isOpen = true;
          setInert(false);
          panel.classList.remove('translate-x-full');
          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          openBtn.setAttribute('aria-expanded', 'true');
          // Lock the page behind the drawer without shifting it: the scrollbar
          // is an overlay on the touch viewports this drawer serves.
          document.documentElement.style.overflow = 'hidden';
          closeBtn.focus();
        };

        const close = ({ restoreFocus = true } = {}) => {
          if (!isOpen) return;
          isOpen = false;
          panel.classList.add('translate-x-full');
          backdrop.classList.add('opacity-0', 'pointer-events-none');
          openBtn.setAttribute('aria-expanded', 'false');
          document.documentElement.style.overflow = '';
          setInert(true);
          if (restoreFocus) openBtn.focus();
        };

        openBtn.addEventListener('click', open);
        closeBtn.addEventListener('click', () => close());
        backdrop.addEventListener('click', () => close());

        document.addEventListener('keydown', e => {
          if (!isOpen) return;
          if (e.key === 'Escape') {
            e.preventDefault();
            close();
            return;
          }
          if (e.key !== 'Tab') return;
          // Keep focus inside the drawer while it owns the screen.
          const items = focusables();
          if (!items.length) return;
          const first = items[0];
          const last = items[items.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        });

        // Crossing into the desktop breakpoint hides the drawer via CSS, which
        // would otherwise leave the page scroll locked.
        const desktop = window.matchMedia('(min-width: 1024px)');
        desktop.addEventListener('change', e => {
          if (e.matches) close({ restoreFocus: false });
        });
      }
    </script>
  </body>
</html>
