---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="See You at the Library 2025"
  description="Join thousands of families for See You at the Library on August 16, 2025 — a nationwide day of faith-centered story hours at 1,000+ public libraries."
>

  <!-- Countdown hero -->
  <section class="bg-brand-rust text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-red-200 mb-4">One Day. Everywhere.</p>
      <h1 class="text-3xl md:text-4xl font-serif font-bold">August 16, 2025</h1>
      <p class="mt-5 text-xl text-red-100 max-w-2xl mx-auto">
        See You at the Library — 1,000+ simultaneous story hours at public libraries across all 50 states.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
        <a href="https://app.feathery.io" target="_blank" class="inline-block bg-white text-brand-rust font-bold py-3 px-8 rounded-lg hover:bg-red-50 transition-colors">
          Find a Library Near You
        </a>
        <a href="/host" class="inline-block border-2 border-white text-white font-bold py-3 px-8 rounded-lg hover:bg-white hover:text-brand-rust transition-colors">
          Register Your Library
        </a>
      </div>
    </div>
  </section>

  <!-- Key details -->
  <section class="py-16 bg-brand-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { icon: '📅', title: 'Date', detail: 'August 16, 2025' },
          { icon: '📍', title: 'Locations', detail: '1,000+ public libraries nationwide' },
          { icon: '🏛️', title: 'Flagship Venue', detail: 'Library of Congress, Washington D.C.' },
          { icon: '🏛️', title: 'Partner', detail: 'U.S. Dept. of Education, Center for Faith' },
          { icon: '🎟️', title: 'Admission', detail: 'Free and open to all families' },
          { icon: '👶', title: 'Ages', detail: 'Children ages 2–12 (all are welcome)' },
        ].map(item => (
          <div class="bg-white rounded-xl p-6 flex gap-4 items-start shadow-sm">
            <span class="text-3xl">{item.icon}</span>
            <div>
              <p class="font-semibold text-brand-navy">{item.title}</p>
              <p class="text-gray-600 text-sm mt-1">{item.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured speakers -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading">Flagship Event Speakers</h2>
      <p class="section-subheading mt-3">The Library of Congress event features nationally recognized voices for family and faith.</p>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-8">
        {[
          {
            name: 'Kirk Cameron',
            desc: 'Actor, author, and founder of BRAVE Books. Kirk has championed library story hours since 2022 when several cities refused to host events for his books — sparking the See You at the Library movement.',
          },
          {
            name: 'Riley Gaines',
            desc: 'NCAA swimming champion and advocate for women\'s sports. Riley is a nationally recognized speaker on courage and standing up for truth, themes at the core of every Brave for Good event.',
          },
          {
            name: 'Kevin Sorbo',
            desc: 'Actor and author known for roles in Hercules and God\'s Not Dead. Kevin brings his platform and passion for faith-centered storytelling to families across the country.',
          },
        ].map(speaker => (
          <div class="text-center">
            <div class="w-32 h-32 rounded-full bg-gradient-to-br from-brand-light to-brand-cream mx-auto flex items-center justify-center mb-4">
              <svg class="w-16 h-16 text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
              </svg>
            </div>
            <h3 class="text-xl font-serif font-bold text-brand-navy">{speaker.name}</h3>
            <p class="mt-3 text-gray-600 text-sm leading-relaxed max-w-xs mx-auto">{speaker.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Event schedule -->
  <section class="py-16 bg-brand-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading">Schedule</h2>
      <p class="section-subheading mt-3">Individual library events may vary. Times below reflect the Library of Congress flagship event.</p>
      <div class="mt-8 max-w-2xl">
        <div class="space-y-1">
          {[
            { time: 'TBD', item: 'Doors open' },
            { time: 'TBD', item: 'Welcome remarks' },
            { time: 'TBD', item: 'Story hour reading' },
            { time: 'TBD', item: 'Speaker program' },
            { time: 'TBD', item: 'Family activities & meet-and-greet' },
          ].map(slot => (
            <div class="flex gap-6 py-3 border-b border-gray-200">
              <span class="w-20 shrink-0 text-sm font-mono text-brand-rust">{slot.time}</span>
              <span class="text-gray-700">{slot.item}</span>
            </div>
          ))}
        </div>
        <p class="mt-4 text-sm text-gray-500">Full schedule will be published closer to the event date.</p>
      </div>
    </div>
  </section>

  <!-- Library map placeholder -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading">Find a Library Near You</h2>
      <p class="section-subheading mt-3">Search the directory of registered libraries hosting story hours on August 16.</p>
      <div class="mt-8 bg-brand-cream rounded-2xl border border-gray-200 h-96 flex items-center justify-center text-gray-400">
        <div class="text-center">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <p class="text-sm font-medium">Interactive library map</p>
          <p class="text-xs mt-1">(Embed your library finder here)</p>
          <a href="https://app.feathery.io" target="_blank" class="mt-4 inline-block btn-primary text-sm py-2 px-5">
            Open Library Finder →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Host CTA -->
  <section class="py-16 bg-brand-navy text-white text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-3xl font-serif font-bold">Is Your Library on the Map?</h2>
      <p class="mt-4 text-gray-300 text-lg">Registration is open for hosts who want to bring a story hour to their local library on August 16.</p>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
        <a href="/host" class="btn-primary">Register as a Host</a>
        <a href="/contact" class="btn-secondary border-white text-white hover:bg-white hover:text-brand-navy">Ask a Question</a>
      </div>
    </div>
  </section>

</Layout>
