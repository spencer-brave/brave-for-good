---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Programs"
  description="Explore Brave for Good's community programs, including See You at the Library and Bible of the Revolution."
>

  <section class="bg-brand-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-serif font-bold">Our Programs</h1>
      <p class="mt-4 text-lg text-gray-300 max-w-2xl">
        Brave for Good creates intentional spaces where families can gather, share meaningful stories, and build lasting community connections.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">

      <!-- See You at the Library -->
      <div class="bg-brand-cream rounded-2xl overflow-hidden md:flex">
        <div class="md:w-1/3 overflow-hidden">
          <img
            src="/images/event-1.avif"
            alt="Families gathered at a Brave Story Hour event"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="p-8 md:p-10 flex-1">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-rust mb-3">Flagship Program</p>
          <h2 class="text-2xl font-serif font-bold text-brand-navy">See You at the Library</h2>
          <p class="mt-4 text-gray-700 leading-relaxed">
            A nationwide movement of faith-centered story hours held simultaneously in public libraries. Families gather to hear character-building stories from BRAVE Books, connect with neighbors, and celebrate a shared love of reading and enduring values.
          </p>
          <div class="mt-6 grid grid-cols-3 gap-4 text-center">
            {[
              { stat: '300+',    label: '2024 Story Hours' },
              { stat: '46',      label: 'States in 2024' },
              { stat: 'Oct 3',   label: '2026 Event Date' },
            ].map(s => (
              <div>
                <div class="text-2xl font-serif font-bold text-brand-navy">{s.stat}</div>
                <div class="text-xs text-gray-500 mt-1">{s.label}</div>
              </div>
            ))}
          </div>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/seeyouatthelibrary" class="btn-primary">Learn More</a>
            <a href="https://form.feathery.io/to/PdY3VK" target="_blank" rel="noopener" class="btn-secondary">Host a Story Hour →</a>
          </div>
        </div>
      </div>

      <!-- Bible Revival -->
      <div class="bg-brand-cream rounded-2xl overflow-hidden md:flex">
        <div class="md:w-1/3 overflow-hidden">
          <img
            src="/images/bible-of-the-revolution.webp"
            alt="Bible of the Revolution — the Aitken Bible"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="p-8 md:p-10 flex-1">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-rust mb-3">New Program</p>
          <h2 class="text-2xl font-serif font-bold text-brand-navy">Bible Revival</h2>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Inspired by America's 250th anniversary, Brave for Good and Kirk Cameron are working to get Bibles and biblical education back into our schools, through free assemblies for schools and groups and free literature for families.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/programs/bible-of-the-revolution" class="btn-primary">Learn More</a>
            <a href="/programs/bible-revival/donate" class="btn-secondary">Get Your Copy →</a>
          </div>
        </div>
      </div>

      <!-- Iggy and Mr. Kirk -->
      <div class="bg-brand-cream rounded-2xl overflow-hidden md:flex">
        <div class="md:w-1/3 overflow-hidden">
          <img
            src="/images/iggy-kirk-puppets.webp"
            alt="Kirk Cameron with the Iggy and Mr. Kirk puppet characters"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="p-8 md:p-10 flex-1">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-rust mb-3">Original Programming</p>
          <h2 class="text-2xl font-serif font-bold text-brand-navy">Iggy and Mr. Kirk</h2>
          <p class="mt-4 text-gray-700 leading-relaxed">
            A modern-day Mr. Rogers' Neighborhood starring Kirk Cameron. Now distributed across many
            platforms, the show has become a household favorite by giving children godly,
            character-building content instead of what the culture hands them.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/programs/iggy-and-mr-kirk" class="btn-primary">Learn More</a>
          </div>
        </div>
      </div>

      <!-- Book Donations -->
      <div class="bg-brand-cream rounded-2xl overflow-hidden md:flex">
        <div class="md:w-1/3 overflow-hidden">
          <img
            src="/images/books-ahg-fiona.webp"
            alt="Children holding their donated BRAVE Books"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="p-8 md:p-10 flex-1">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-rust mb-3">Giving Program</p>
          <h2 class="text-2xl font-serif font-bold text-brand-navy">Book Donations</h2>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Stories shape worldview, so we put BRAVE Books into the hands of the children least likely to
            own one: underprivileged youth, families experiencing difficulty, children's hospitals, and
            military families.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/programs/book-donations" class="btn-primary">Learn More</a>
          </div>
        </div>
      </div>

    </div>
  </section>

</Layout>
