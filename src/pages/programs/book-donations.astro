---
import Layout from '../../layouts/Layout.astro';

const recipients = [
  {
    num: '01',
    title: 'Underprivileged youth and families in hardship',
    body: 'Children who would not otherwise own a book of their own, in communities where a home library is a luxury, and households in the middle of hardship, where a story read together at the end of the day is worth more than it costs.',
  },
  {
    num: '02',
    title: "Children's hospitals",
    body: 'Long treatment days and longer nights. A story is a way out of the room without leaving the bed.',
  },
  {
    num: '03',
    title: 'Military families',
    body: 'Children navigating deployments, moves, and long absences, who deserve stories about courage that meet them where they are.',
  },
  {
    num: '04',
    title: 'Little Free Library',
    body: 'Neighborhood book exchanges where a title left on a shelf finds the next reader on its own. We stock them so a good story is waiting on the walk home.',
  },
];
---

<Layout
  title="Book Donations"
  description="Brave for Good puts BRAVE Books into the hands of underprivileged youth and families in hardship, children's hospitals, military families, and Little Free Libraries."
>

  <section class="bg-brand-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-gold mb-4">Brave for Good Programs</p>
      <h1 class="text-3xl md:text-4xl font-serif font-bold">Book Donations</h1>
      <p class="mt-4 text-lg text-gray-300 max-w-2xl">
        Putting BRAVE Books into the hands of the children who need them most.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4">
        <a href="/support" class="btn-primary text-center">Donate Books</a>
        <a href="#request-books" class="btn-secondary border-white text-white hover:bg-white hover:text-brand-navy text-center">
          Request Books
        </a>
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h2 class="section-heading">Why We Give Books Away</h2>
          <div class="mt-6 space-y-4 text-gray-700 leading-relaxed text-lg">
            <p>
              We believe literacy is important. We know how crucial stories can be in shaping worldview.
            </p>
            <p>
              Jesus used parables to illustrate his teachings, and we do the same. For the same reason, we
              want to make BRAVE Books available to underprivileged youth and families in hardship,
              children's hospitals, military families, and Little Free Libraries.
            </p>
          </div>
        </div>
        <div class="rounded-xl overflow-hidden">
          <img
            src="/images/books-ahg-fiona.webp"
            alt="Three American Heritage Girls troop members holding their donated copies of Fiona's Fantastical Fort"
            class="w-full block"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Who receives them -->
  <section class="py-16 md:py-20 bg-brand-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-10">Who Receives Them</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
        {recipients.map(item => (
          <div>
            <div class="text-4xl font-serif font-bold text-gray-300 leading-none mb-3 select-none">{item.num}</div>
            <h3 class="text-lg font-serif font-bold text-brand-navy">{item.title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Books in hands -->
  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h2 class="section-heading">Books in Hands</h2>
        <p class="section-subheading mt-3">
          Recent distributions, including copies given to American Heritage Girls troop members at their
          national gathering and non-profits supporting inner city literacy programs.
        </p>
      </div>
      <div class="mt-10 grid md:grid-cols-2 gap-6">
        <div class="rounded-xl overflow-hidden">
          <img
            src="/images/books-ahg-camilla.webp"
            alt="American Heritage Girls troop members holding their donated copies of Camilla Can Vote"
            class="w-full h-full aspect-[4/3] object-cover block"
            loading="lazy"
          />
        </div>
        <div class="rounded-xl overflow-hidden">
          <img
            src="/images/tackle-tomorrow.webp"
            alt="Students holding their donated BRAVE Books at a Tackle Tomorrow inner city literacy program"
            class="w-full h-full aspect-[4/3] object-cover block"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Request books -->
  <section id="request-books" class="py-16 md:py-20 bg-brand-cream scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16">
        <div class="max-w-xl">
          <h2 class="section-heading">Request Books</h2>
          <div class="mt-6 space-y-4 text-gray-700 leading-relaxed">
            <p>
              If you serve children who would benefit from BRAVE Books, tell us about your group. We
              work with schools, churches, hospitals, shelters, military family programs, nonprofits,
              and Little Free Library stewards.
            </p>
            <p>
              Send the form and our team will follow up within 2 business days to confirm titles,
              quantities, and shipping. There is no cost to you.
            </p>
          </div>
        </div>

        <form class="space-y-4" action="https://formspree.io/f/xbdvpgqw" method="POST">
          <input type="hidden" name="_subject" value="Book Request — Brave for Good" />
          <div>
            <label for="rb-name" class="block text-sm font-medium text-gray-700 mb-1">Your Name</label>
            <input type="text" id="rb-name" name="name" required
              class="w-full rounded-lg border border-gray-300 px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-brand-rust" />
          </div>
          <div>
            <label for="rb-email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" id="rb-email" name="email" required
              class="w-full rounded-lg border border-gray-300 px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-brand-rust" />
          </div>
          <div>
            <label for="rb-organization" class="block text-sm font-medium text-gray-700 mb-1">Organization / Group Name</label>
            <input type="text" id="rb-organization" name="organization" required
              class="w-full rounded-lg border border-gray-300 px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-brand-rust" />
          </div>
          <div>
            <label for="rb-quantity" class="block text-sm font-medium text-gray-700 mb-1">How many books do you need?</label>
            <input type="number" id="rb-quantity" name="quantity" min="1" inputmode="numeric" required
              class="w-full rounded-lg border border-gray-300 px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-brand-rust" />
          </div>
          <div>
            <label for="rb-message" class="block text-sm font-medium text-gray-700 mb-1">Tell us about your group</label>
            <textarea id="rb-message" name="message" rows={5} required
              class="w-full rounded-lg border border-gray-300 px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-brand-rust"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full text-center">
            Send Request
          </button>
        </form>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 bg-brand-navy text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="max-w-xl">
          <h2 class="text-2xl font-serif font-bold">Send a Book to a Child</h2>
          <p class="mt-3 text-gray-300 leading-relaxed">
            Every gift buys books and ships them to a hospital, a shelter, or a base. Your donation is
            tax-deductible.
          </p>
        </div>
        <div class="shrink-0 flex flex-col sm:flex-row gap-3">
          <a href="/support" class="btn-primary text-center">Donate</a>
          <a href="#request-books" class="btn-secondary border-white text-white hover:bg-white hover:text-brand-navy text-center">
            Request Books
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
