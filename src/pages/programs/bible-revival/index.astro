---
import Layout from '../../../layouts/Layout.astro';

// The Bible of the Revolution offer (donate $100 / $17.76 a month to receive a
// copy) is paused. Flip this to true to bring the "Get Your Copy" buttons and
// the donate-page links back.
const offerBibleOfTheRevolution = false;
---

<Layout
  title="Bible Revival"
  description="Bible Revival is Brave for Good's program to get Bibles and biblical education back into American schools, with free assemblies for schools and groups and free literature for families."
>

  <section class="bg-brand-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-gold mb-4">Brave for Good Programs</p>
      <h1 class="text-3xl md:text-4xl font-serif font-bold">Bible Revival</h1>
      <p class="mt-4 text-lg text-gray-300 max-w-2xl">
        Getting Bibles and biblical education back into our schools, in time for America's 250th anniversary.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4">
        <a href="/contact" class="btn-primary text-center">Request a Free Assembly</a>
      </div>
    </div>
  </section>

  <!-- Video section -->
  <section class="py-16 bg-brand-sand border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="video-container" role="button" aria-label="Play video about Bible of the Revolution" tabindex="0">
        <img
          src="/images/bible-video-thumbnail.webp"
          alt="Bible of the Revolution — click to watch"
          class="w-full block"
        />
        <div class="overlay"></div>
        <div class="play-btn">
          <svg width="36" height="36" fill="black" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- About the program -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-16 items-start">

        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-bold text-brand-navy">What is Bible Revival?</h2>
          <div class="mt-6 space-y-4 text-gray-700 leading-relaxed">
            <p>
              The Bible was instrumental in the founding of America, and children today are not being taught its significance in how it influenced America's first leaders. The Bible inspired their philosophy, morals, and values, and provided a framework for justice, economics, labor, and more.
            </p>
            <p>
              In 1782, the Continental Congress passed a resolution endorsing the Aitken Bible, the first complete Bible to be printed on American soil.
            </p>
            <p>
              Inspired by America's 250th anniversary, Brave for Good and Kirk Cameron are working to get Bibles and biblical education back into our schools. We are offering free assemblies to schools and groups, and providing free literature to equip families on how to engage their local schools with biblical materials.
            </p>
          </div>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/contact" class="btn-primary">Request a Free Assembly</a>
          </div>
        </div>

        <div>
          <img
            src="/images/bible-of-the-revolution.webp"
            alt="The Bible of the Revolution, a reprint of the Aitken Bible of 1782"
            class="w-full rounded-sm"
            loading="lazy"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- Key points -->
  <section class="py-16 bg-brand-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-serif font-bold text-brand-navy mb-10">How the Program Works</h2>
      <div class="grid md:grid-cols-3 gap-12">
        {[
          {
            num: '01',
            title: 'Free assemblies',
            body: 'We bring the story of the Bible\'s role in America\'s founding directly to schools and groups, at no cost to the host.',
          },
          {
            num: '02',
            title: 'Free literature',
            body: 'We equip families with the materials they need to engage their local schools about biblical materials, and to do it well.',
          },
          {
            num: '03',
            title: 'The 250th anniversary',
            body: 'America turns 250 in 2026. It is the right moment to teach a generation where the country\'s founding ideas actually came from.',
          },
        ].map(item => (
          <div>
            <div class="text-4xl font-serif font-bold text-gray-200 leading-none mb-3 select-none">{item.num}</div>
            <h3 class="text-lg font-serif font-bold text-brand-navy">{item.title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTR feature -->
  <section class="py-16 bg-brand-navy text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-14 items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-gold mb-4">Featured Piece</p>
          <h2 class="text-2xl md:text-3xl font-serif font-bold">The Bible of the Revolution</h2>
          <div class="mt-5 w-14 h-0.5 bg-brand-gold"></div>
          <p class="mt-6 text-gray-300 leading-relaxed">
            In 1782, Robert Aitken printed the first complete Bible on American soil, and the Continental Congress passed a resolution endorsing it. Small enough to fit in a Continental soldier's coat pocket, it was printed five years before the Constitution.
          </p>
          <p class="mt-4 text-gray-300 leading-relaxed">
            Brave for Good is making this historic Bible available again, with a preface written by Kirk Cameron, and telling its story in the assemblies we bring to schools and groups.
          </p>
          {offerBibleOfTheRevolution && (
            <>
              <div class="mt-8 flex flex-col sm:flex-row gap-4">
                <a href="/programs/bible-revival/donate" class="btn-primary">Get Your Copy</a>
                <a href="/programs/bible-revival/donate" class="inline-block border border-white/40 text-white font-semibold px-7 py-3 rounded-lg hover:border-white hover:bg-white/10 transition-colors text-center">
                  Learn More →
                </a>
              </div>
              <p class="mt-4 text-xs text-gray-500">Books begin shipping late September 2026.</p>
            </>
          )}
        </div>
        <div>
          <img
            src="/images/bible-of-the-revolution.webp"
            alt="Bible of the Revolution"
            class="w-full rounded-sm"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Support CTA -->
  <section class="py-14 bg-brand-cream border-t border-gray-200">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-serif font-bold text-brand-navy">Support Bible Revival</h2>
      <p class="mt-4 text-gray-600 leading-relaxed">
        The assemblies and the family literature are free because donors cover them. Help us reach the next school.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/support" class="btn-primary">Donate</a>
        <a href="/contact" class="btn-secondary">Get in Touch</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  #video-container {
    position: relative;
    cursor: pointer;
    display: block;
  }
  #video-container .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    transition: background 0.2s ease;
  }
  #video-container:hover .overlay {
    background: rgba(0, 0, 0, 0.45);
  }
  #video-container .play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  #video-container .play-btn svg {
    margin-left: 4px;
  }
  #video-container:hover .play-btn {
    background: rgba(255, 255, 255, 1);
    transform: translate(-50%, -50%) scale(1.06);
  }
</style>

<script>
  const container = document.getElementById('video-container');

  function loadVideo() {
    const iframe = document.createElement('iframe');
    iframe.src = 'https://www.youtube.com/embed/LJZrKP-aZ1w?autoplay=1';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.className = 'w-full aspect-video block';
    iframe.style.border = 'none';

    container!.replaceChildren(iframe);
    container!.style.cursor = 'default';
  }

  container?.addEventListener('click', loadVideo);
  container?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      loadVideo();
    }
  });
</script>
