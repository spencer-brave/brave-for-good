---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Support Our Work"
  description="Donate to Brave for Good and help fund faith-centered story hours in public libraries across America."
>

  <!-- Lead photo. Capped narrower than the form below it: at full width the
       photo pushes the Anedot embed off the first screen. -->
  <section class="pt-6 md:pt-8">
    <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8">
      <img
        src="/images/kirk-story-hour-group.webp"
        alt="Kirk Cameron and a room full of families holding American flags at a Brave Story Hour"
        class="w-full rounded-2xl"
        width="1280"
        height="740"
        loading="eager"
      />
    </div>
  </section>

  <!-- Donation form -->
  <section class="pt-6 pb-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="max-w-xl mx-auto text-center text-base md:text-lg font-serif text-brand-navy leading-relaxed">
        Every gift directly funds BRAVE For Good's mission, inspiring children to walk in God's ways.
      </p>
      <div class="mt-5 w-16 h-0.5 bg-brand-gold mx-auto"></div>
      <iframe
        src="https://secure.anedot.com/brave-for-good/435a98d6-f370-4f8d-8789-0551c447df7e?embed=true"
        width="100%"
        style="border: none; min-height: 700px;"
        title="Donate to Brave for Good"
        class="mt-6"
      ></iframe>
    </div>
  </section>

  <!-- How funds are used -->
  <section class="py-16 bg-brand-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="section-heading">Where Your Money Goes</h2>
        <p class="mt-4 text-gray-600">We are committed to using your gifts efficiently and transparently.</p>
        <div class="mt-8 space-y-4">
          {[
            { pct: 78, label: 'Programs & Events', color: 'bg-brand-rust' },
            { pct: 13, label: 'Fundraising', color: 'bg-brand-gold' },
            { pct: 9,  label: 'Administration', color: 'bg-brand-blue' },
          ].map(item => (
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span class="font-medium text-brand-navy">{item.label}</span>
                <span class="text-gray-500">{item.pct}%</span>
              </div>
              <div class="h-3 bg-gray-200 rounded-full overflow-hidden">
                <div class={`h-full rounded-full ${item.color}`} style={`width: ${item.pct}%`}></div>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-4 text-xs text-gray-400">Based on FY2024 actuals. <a href="/grants" class="text-brand-rust hover:underline">Full financial documents available here.</a></p>
      </div>
    </div>
  </section>

  <!-- Other ways to give -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading">Other Ways to Give</h2>
      <div class="mt-8 grid md:grid-cols-2 gap-6 max-w-2xl">
        {[
          {
            title: 'Corporate Sponsorship',
            body: 'Companies can sponsor story hour programs in a specific city or state. Contact us to build a custom sponsorship package.',
            cta: 'Contact Us',
            href: '/contact',
          },
          {
            title: 'Planned Giving',
            body: 'Leave a lasting legacy by including Brave for Good in your estate plan. Contact us to learn about bequest opportunities.',
            cta: 'Learn More',
            href: '/contact',
          },
        ].map(item => (
          <div class="bg-brand-cream rounded-2xl p-6">
            <h3 class="text-xl font-serif font-bold text-brand-navy">{item.title}</h3>
            <p class="mt-3 text-gray-600 leading-relaxed">{item.body}</p>
            <a href={item.href} class="mt-4 inline-block text-brand-rust font-semibold text-sm hover:underline">{item.cta} →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tax info -->
  <section class="py-12 bg-brand-navy text-white">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-xl font-semibold mb-3">Your Donation is Tax-Deductible</h2>
      <p class="text-gray-300 text-sm leading-relaxed">
        Brave for Good is a tax-exempt 501(c)(3) public charity (EIN: 39-2416029). Contributions are deductible to the full extent of the law. A donation acknowledgment will be emailed to you for your tax records.
      </p>
    </div>
  </section>

</Layout>
