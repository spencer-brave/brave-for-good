---
import Layout from '../layouts/Layout.astro';

const carouselPrograms = [
  {
    href: '/seeyouatthelibrary',
    label: 'See You at the Library',
    blurb: 'A nationwide day of story hours held simultaneously in public libraries.',
    image: '/images/event-1.avif',
    alt: 'Families seated together at a Brave Story Hour in a library',
  },
  {
    href: '/programs/bible-revival',
    label: 'Bible Revival',
    blurb: "Free assemblies and family literature, in time for America's 250th.",
    image: '/images/bible-revival-assembly.webp',
    alt: 'Kirk Cameron speaking to a seated audience at a Bible Revival assembly',
  },
  {
    href: '/programs/iggy-and-mr-kirk',
    label: 'Faith Forward Content Creation',
    blurb: 'Shows that hand children godly stories, starting with Iggy and Mr. Kirk.',
    image: '/images/iggy-kirk-puppets.webp',
    alt: 'Kirk Cameron and the Iggy and Mr. Kirk cast holding their puppet characters',
  },
  {
    href: '/programs/book-donations',
    label: 'Book Donations',
    blurb: 'BRAVE Books in the hands of the children least likely to own one.',
    image: '/images/books-ahg-fiona.webp',
    alt: 'Three girls holding their donated copies of a BRAVE Books title',
  },
];
---

<Layout
  title="Home"
  description="Brave for Good equips families with stories and community experiences grounded in faith and timeless values. Join us at the library."
>

  <!-- Hero — 2-column: text left, real event photo right -->
  <section class="bg-brand-navy text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
      <div class="grid min-[800px]:grid-cols-[1fr_0.6fr] min-[800px]:gap-16 items-center">
        <div>
          <p class="text-brand-gold text-xs font-semibold uppercase tracking-[0.2em] mb-6">
            501(c)(3) Nonprofit &nbsp;·&nbsp; Established 2025
          </p>
          <!-- Size/leading shorthand on every step: a bare leading-* loses to
               the line-height that each responsive text-* utility resets. -->
          <h1 class="max-w-[600px] text-4xl/[1.14] md:text-5xl/[1.14] lg:text-6xl/[1.14] font-serif font-bold tracking-tight text-white">
            Inspiring Children to Walk in <em class="not-italic text-brand-gold">God's Ways</em>.
          </h1>
          <div class="mt-8 w-16 h-0.5 bg-brand-gold"></div>
          <p class="mt-6 text-base md:text-lg text-gray-300 leading-relaxed max-w-lg">
            We equip families with stories and community gatherings that nurture imagination, strengthen timeless values, and raise a generation grounded in truth, courage, and character.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a href="/support" class="btn-primary text-base py-3 px-7 text-center">
              Donate
            </a>
            <a href="#impact" class="inline-block border border-white/40 text-white font-semibold px-7 py-3 rounded-lg hover:border-white hover:bg-white/10 transition-colors text-center text-base">
              See Our Impact
            </a>
          </div>
        </div>
        <div class="mt-12 min-[800px]:mt-0">
          <img
            src="/images/kirk-scarsdale-reading.avif"
            alt="Kirk Cameron reading to families at a Brave Story Hour in Scarsdale, NY"
            class="w-full"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 2025 Impact — editorial typographic layout, not a dashboard metric grid -->
  <section id="impact" class="bg-brand-sand border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-rust mb-8">2025 Annual Results</p>
      <div class="flex flex-col sm:flex-row sm:divide-x divide-gray-300 gap-8 sm:gap-0">
        <div class="sm:pr-12">
          <div class="text-4xl md:text-5xl font-serif font-bold text-brand-navy leading-none">10,000+</div>
          <div class="mt-2 text-sm font-medium text-gray-600 uppercase tracking-widest">Families reached</div>
        </div>
        <div class="sm:px-12">
          <div class="text-4xl md:text-5xl font-serif font-bold text-brand-navy leading-none">300+</div>
          <div class="mt-2 text-sm font-medium text-gray-600 uppercase tracking-widest">Story hours hosted</div>
        </div>
        <div class="sm:px-12">
          <div class="text-4xl md:text-5xl font-serif font-bold text-brand-navy leading-none">46</div>
          <div class="mt-2 text-sm font-medium text-gray-600 uppercase tracking-widest">States participated</div>
        </div>
        <div class="sm:pl-12 flex flex-col justify-end">
          <a href="/impact" class="text-brand-rust text-sm font-semibold hover:underline underline-offset-4">
            Full impact report →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Programs carousel — a sliding track: one program per view below lg, two
       across at lg. Each item is exactly one view wide (or half of one), so a
       page step is always a translateX of one container width. Transform only;
       flex keeps every item the height of the tallest, so nothing reflows. -->
  <section id="programs-carousel" class="bg-brand-navy text-white" aria-labelledby="programs-carousel-label">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">

      <div class="flex items-baseline justify-between gap-4">
        <p id="programs-carousel-label" class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-gold">
          Our Programs
        </p>
        <a href="/programs" class="text-sm font-semibold text-white/70 hover:text-white transition-colors whitespace-nowrap">
          See all →
        </a>
      </div>

      <div class="mt-6 overflow-hidden">
        <ul
          class="flex transition-transform duration-700 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] motion-reduce:transition-none"
          data-track
        >
          {carouselPrograms.map(program => (
            <li class="w-full lg:w-1/2 shrink-0 lg:pr-10" data-item>
              <div class="flex items-center gap-5 sm:gap-7">
                <img
                  src={program.image}
                  alt={program.alt}
                  class="h-20 w-20 sm:h-24 sm:w-32 shrink-0 rounded-lg object-cover"
                  loading="lazy"
                />
                <div class="min-w-0">
                  <h2 class="font-serif text-xl sm:text-2xl font-bold leading-snug">
                    <a href={program.href} class="hover:text-brand-gold transition-colors">
                      {program.label}
                    </a>
                  </h2>
                  <p class="mt-1.5 text-sm text-gray-300 leading-relaxed">{program.blurb}</p>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-6 flex items-center gap-4">
        <div class="flex items-center gap-2" data-dots role="group" aria-label="Jump to programs"></div>

        <button
          type="button"
          data-toggle
          class="ml-auto p-1.5 rounded text-white/50 hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:ring-offset-2 focus-visible:ring-offset-brand-navy"
          aria-label="Pause program rotation"
        >
          <svg data-icon-pause class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5h3v14H8zM13 5h3v14h-3z"/>
          </svg>
          <svg data-icon-play class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </button>
      </div>

    </div>
  </section>

  <!-- Why we exist — numbered editorial list, not an icon+card grid -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <h2 class="text-2xl md:text-3xl font-serif font-bold text-brand-navy leading-tight">
          Stories shape who children become.
        </h2>
        <p class="mt-4 text-base text-gray-600 leading-relaxed">
          In a world full of noise, families deserve meaningful stories and welcoming spaces where faith, imagination, and community can thrive.
        </p>
      </div>
      <div class="space-y-10 md:space-y-0 md:grid md:grid-cols-3 md:gap-14">
        {[
          {
            num: '01',
            title: 'Imagination awakened',
            body: 'Great stories ignite curiosity and open young minds to a world of wonder grounded in truth. Children who read widely, dream widely.',
          },
          {
            num: '02',
            title: 'Character formed',
            body: 'When children encounter courage, honor, and kindness in stories, those values take root. Literature is moral formation that doesn\'t feel like a lesson.',
          },
          {
            num: '03',
            title: 'Communities strengthened',
            body: 'Our gatherings bring neighbors together in public spaces families already call home. Shared stories create social bonds that last.',
          },
        ].map(item => (
          <div>
            <div class="text-4xl font-serif font-bold text-gray-200 leading-none mb-3 select-none">{item.num}</div>
            <h3 class="text-lg font-serif font-bold text-brand-navy">{item.title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Photo strip — 3 real event photos -->
  <section class="bg-brand-sand border-t border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="grid grid-cols-3 gap-2 md:gap-3">
        <img
          src="/images/story-hour-hendersonville.avif"
          alt="Brave Story Hour event in Hendersonville — families gathered at the library"
          class="w-full h-44 md:h-64 object-cover"
          loading="lazy"
        />
        <img
          src="/images/story-hour-springfield.avif"
          alt="Brave Story Hour in Springfield — children and parents listening to stories"
          class="w-full h-44 md:h-64 object-cover"
          loading="lazy"
        />
        <img
          src="/images/story-hour-taylor-tx.avif"
          alt="See You at the Library 2023 pledge event in Taylor, TX"
          class="w-full h-44 md:h-64 object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- 2025 Event CTA — strong, flat, proclamation-style -->
  <section class="bg-brand-rust text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="grid lg:grid-cols-2 lg:gap-16 items-center">
        <div class="max-w-xl">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-red-200 mb-5">October 3, 2026</p>
          <h2 class="text-3xl md:text-4xl font-serif font-bold leading-tight">
            See You<br />at the Library.
          </h2>
          <div class="mt-5 w-14 h-0.5 bg-red-300"></div>
          <p class="mt-6 text-base text-red-100 leading-relaxed">
            A nationwide day of simultaneous story hours in public libraries. Hundreds of parents, grandparents, community leaders, and pastors volunteer to host a story at their local library, and we supply the books, activities, and resources.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a href="/seeyouatthelibrary" class="inline-block bg-white text-brand-rust font-bold py-3 px-7 rounded-lg hover:bg-red-50 transition-colors text-center">
              Learn More
            </a>
            <a href="/host" class="inline-block border border-white/40 text-white font-semibold py-3 px-7 rounded-lg hover:border-white hover:bg-white/10 transition-colors text-center">
              Host at Your Library
            </a>
          </div>
        </div>
        <div class="mt-10 lg:mt-0">
          <img
            src="/images/trent-talbot.avif"
            alt="See You at the Library event"
            class="w-full"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <svg class="w-7 h-7 text-brand-gold mb-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
      </svg>
      <blockquote class="text-xl md:text-2xl font-serif text-brand-navy leading-relaxed">
        "Our library's story hour brought over 80 families together on a Saturday morning. Parents told me afterward they hadn't felt that sense of community in years."
      </blockquote>
      <cite class="mt-6 block text-xs text-gray-400 not-italic uppercase tracking-widest">
        Library Host, Columbus, Ohio
      </cite>
    </div>
  </section>


</Layout>

<script>
  const region = document.getElementById('programs-carousel');

  if (region) {
    const track = region.querySelector<HTMLElement>('[data-track]');
    const items = Array.from(region.querySelectorAll<HTMLElement>('[data-item]'));
    const dotsBox = region.querySelector<HTMLElement>('[data-dots]');
    const toggle = region.querySelector<HTMLButtonElement>('[data-toggle]');
    const iconPause = region.querySelector<SVGElement>('[data-icon-pause]');
    const iconPlay = region.querySelector<SVGElement>('[data-icon-play]');

    if (track && dotsBox) {
      const INTERVAL = 8000;
      // Must match the lg:w-1/2 on the items.
      const twoUp = window.matchMedia('(min-width: 1024px)');
      // Rotation still runs for reduced-motion users; only the slide animation
      // is dropped, via motion-reduce:transition-none on the track. The pause
      // control is what satisfies "pause, stop, hide".

      let page = 0;
      let perPage = twoUp.matches ? 2 : 1;
      let pageCount = Math.ceil(items.length / perPage);
      let timer: number | undefined;
      // Paused deliberately by the user, as opposed to transiently by hover.
      let stopped = false;

      const dotClass =
        'h-1.5 w-5 rounded-full bg-white/25 transition-all duration-300 ease-out ' +
        'hover:bg-white/50 aria-[current=true]:w-9 aria-[current=true]:bg-brand-gold ' +
        'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold ' +
        'focus-visible:ring-offset-2 focus-visible:ring-offset-brand-navy';

      // Adjacent steps slide. Anything further (the wrap from the last page on
      // mobile, or a dot click across the track) snaps, because rewinding three
      // widths at speed reads as a glitch rather than as motion.
      const goTo = (next: number) => {
        if (Math.abs(next - page) > 1) {
          track.style.transition = 'none';
          page = next;
          render();
          void track.offsetWidth;
          track.style.transition = '';
          return;
        }
        page = next;
        render();
      };

      const render = () => {
        track.style.transform = `translateX(-${page * 100}%)`;
        // Items scrolled out of view must not be reachable by tab or reader.
        items.forEach((item, i) => {
          const visible = Math.floor(i / perPage) === page;
          item.inert = !visible;
          item.setAttribute('aria-hidden', String(!visible));
        });
        Array.from(dotsBox.children).forEach((dot, i) =>
          dot.setAttribute('aria-current', String(i === page))
        );
      };

      const buildDots = () => {
        dotsBox.replaceChildren();
        for (let i = 0; i < pageCount; i++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = dotClass;
          dot.setAttribute(
            'aria-label',
            items
              .slice(i * perPage, i * perPage + perPage)
              .map(item => item.querySelector('h2')?.textContent?.trim())
              .filter(Boolean)
              .join(', ')
          );
          dot.addEventListener('click', () => {
            goTo(i);
            // Choosing a program is deliberate; hold it there.
            setStopped(true);
          });
          dotsBox.append(dot);
        }
      };

      const start = () => {
        if (stopped || timer) return;
        timer = window.setInterval(() => goTo((page + 1) % pageCount), INTERVAL);
      };

      const stop = () => {
        window.clearInterval(timer);
        timer = undefined;
      };

      function setStopped(value: boolean) {
        stopped = value;
        stopped ? stop() : start();
        iconPause?.classList.toggle('hidden', stopped);
        iconPlay?.classList.toggle('hidden', !stopped);
        toggle?.setAttribute(
          'aria-label',
          stopped ? 'Start program rotation' : 'Pause program rotation'
        );
      }

      const layout = () => {
        perPage = twoUp.matches ? 2 : 1;
        pageCount = Math.ceil(items.length / perPage);
        // Keep the leftmost visible program in view across a breakpoint change.
        page = Math.min(page, pageCount - 1);
        buildDots();
        render();
      };

      layout();
      // Rotating from load, no interaction required.
      start();

      toggle?.addEventListener('click', () => setStopped(!stopped));
      twoUp.addEventListener('change', layout);

      // Transient pauses: reading with the pointer, or tabbing through an item.
      // Hover pausing is for real pointers only; on touch there is no leave
      // event to match the enter, so a stray tap would stop rotation for good.
      if (window.matchMedia('(hover: hover)').matches) {
        region.addEventListener('pointerenter', stop);
        region.addEventListener('pointerleave', start);
      }
      region.addEventListener('focusin', stop);
      region.addEventListener('focusout', e => {
        if (!region.contains(e.relatedTarget as Node)) start();
      });

      // Don't rotate in a background tab.
      document.addEventListener('visibilitychange', () =>
        document.hidden ? stop() : start()
      );
    }
  }
</script>
