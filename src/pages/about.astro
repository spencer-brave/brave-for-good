---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About"
  description="Meet the team behind Brave for Good, the nonprofit supporting faith-centered family storytelling across America."
>

  <!-- Page header -->
  <section class="bg-brand-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-serif font-bold">About Brave for Good</h1>
      <p class="mt-4 text-lg text-gray-300 max-w-2xl">
        We are a team of parents, educators, and advocates united by a belief that the stories we tell children shape the world they will build.
      </p>
    </div>
  </section>

  <!-- Our story -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h2 class="section-heading">Our Story</h2>
          <div class="mt-6 space-y-4 text-gray-700 leading-relaxed text-lg">
            <p>
              BRAVE For Good was born out of the charitable efforts of BRAVE Books. BRAVE Books has led
              efforts to push back on drag queen story hours in public libraries across America.
            </p>
            <p>
              From having led on that stance, thousands of patriotic Americans began an outpouring of
              support for our efforts.
            </p>
            <p>
              BRAVE For Good also allows for a more formalized approach to create structural changes that
              allow us to pursue our mission of inspiring children to walk in God's ways.
            </p>
          </div>
        </div>
        <!-- TODO: swap for the "GUM" photo once it is supplied. -->
        <div class="rounded-xl overflow-hidden">
          <img
            src="/images/story-hour-hendersonville.avif"
            alt="Families gathered at a Brave story hour in a public library"
            class="w-full block"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership team -->
  <section class="py-16 bg-brand-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading">Leadership Team</h2>
      <p class="section-subheading mt-3">The people driving our mission forward.</p>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-8 max-w-3xl">
        {[
          {
            name: 'Trent Talbot',
            title: 'President',
          },
          {
            name: 'Nathan Daniels',
            title: 'Director of Development and Partnerships',
          },
          {
            name: 'Kirk Cameron',
            title: 'Spokesperson',
          },
        ].map(person => (
          <div class="bg-white rounded-xl p-6 shadow-sm">
            <h3 class="text-lg font-serif font-bold text-brand-navy">{person.name}</h3>
            <p class="text-brand-rust text-sm font-semibold mt-1">{person.title}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Statement of faith pointer -->
  <section class="py-14 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="max-w-xl">
          <h2 class="text-2xl font-serif font-bold text-brand-navy">Statement of Faith</h2>
          <p class="mt-2 text-gray-600 leading-relaxed">
            Fourteen articles setting out the theological convictions that undergird every program we
            offer, every gathering we host, and every family we serve.
          </p>
        </div>
        <div class="shrink-0">
          <a href="/statement-of-faith" class="btn-primary">Read Our Statement of Faith</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-16 bg-brand-navy text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-serif font-bold text-white mb-10">Our Core Values</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {[
          { title: 'Biblical Truth', body: 'We hold to a moral foundation grounded in Scripture and the timeless wisdom it provides for raising courageous children.' },
          { title: 'Imagination', body: 'We believe great stories open minds to wonder without exploiting or distorting a child\'s developing worldview.' },
          { title: 'Courage', body: 'We cultivate the bravery to advocate for what is right, even when it is difficult or unpopular.' },
          { title: 'Community', body: 'We build spaces of hospitality and shared purpose where families can connect across generations and neighborhoods.' },
        ].map(val => (
          <div class="bg-white/10 rounded-xl p-6">
            <h3 class="text-xl font-serif font-bold text-brand-gold">{val.title}</h3>
            <p class="mt-2 text-gray-200 leading-relaxed">{val.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Financial transparency -->
  <section class="py-12 bg-brand-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <h2 class="text-2xl font-serif font-bold text-brand-navy">Financial Transparency</h2>
          <p class="mt-2 text-gray-600 max-w-xl">
            Brave for Good, Inc. is a 501(c)(3) public charity, EIN <span class="font-mono">39-2416029</span>,
            exempt under IRC Section 501(c)(3) effective May 28, 2025. Contributions are tax-deductible
            under Section 170.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/documents/brave-for-good-501c3-determination-letter.pdf"
            target="_blank"
            rel="noopener"
            class="btn-primary text-sm py-2 px-5 text-center"
          >
            IRS Determination Letter (PDF)
          </a>
          <a href="/grants" class="btn-secondary text-sm py-2 px-5 text-center">
            Funder Information
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
